{
  "name": "waves-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/verify-assets.mjs && node scripts/build.mjs",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:visual": "WAVES_VISUAL=1 playwright test",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "esbuild": "0.25.12"
  }
}
